# build output -- every simulator here writes into a build/ next to its
# sources (rtl/build, verif/uvm/build). Regenerate with run_sim.sh / run_uvm.sh.
build/
build_seeds/
obj_dir/

# waveform dumps / simulator scratch
*.vcd
*.wlf
*.log
transcript
transcript.*
work/
INCA_libs/
csrc/
*.simv
*.daidir/

# Questa/ModelSim scratch
modelsim.ini
vsim.dbg
vsim_stacktrace.vstf
vish_stacktrace.vstf
*.mti
.vlogansetup.args

# editor / IDE state, not shared
.vscode/
.idea/
*.swp
*~

# compiled objects. verif/spike's MMIO plugin is built by its Makefile, which
# regen.sh invokes on every run -- there is no reason to commit the binary.
*.o
*.so
*.out

# python
__pycache__/
*.pyc

# OS cruft
.DS_Store
Thumbs.db
desktop.ini

# local tool config, not shared
.claude/
.out-of-code-insights/

# personal working notes -- scratch for my own study, not part of the design
MyRISCVBallKnowledge.md
